# The admin service is intentionally bound only to Lippy's isolated-network IP.
ADMIN_BIND_HOST=192.168.50.2

# Generate with:
# python3 -c "import secrets; print('ssa_' + secrets.token_urlsafe(48))"
ADMIN_TOKEN=replace_me_with_a_long_random_token

# Cloudflare tunnel
TUNNEL_TOKEN=replace_me_with_tunnel_token
# Optional Cloudflare Access identity validation for the hosted admin dashboard.
# Find the team domain under Zero Trust -> Settings -> Team name and domain.
# Example: https://your-team.cloudflareaccess.com
CLOUDFLARE_ACCESS_TEAM_DOMAIN=

# Find the Application Audience (AUD) Tag under:
# Zero Trust -> Access controls -> Applications -> admin -> Additional settings
CLOUDFLARE_ACCESS_AUD=
